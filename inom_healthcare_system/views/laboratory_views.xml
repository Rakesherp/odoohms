<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================
         LAB TEST TYPE / CONFIGURATION
         ============================================================ -->

    <record id="lab_test_type_list" model="ir.ui.view">
        <field name="name">oeh.lab.test.type.list</field>
        <field name="model">oeh.lab.test.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="fee"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="lab_test_type_form" model="ir.ui.view">
        <field name="name">oeh.lab.test.type.form</field>
        <field name="model">oeh.lab.test.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="fee" readonly="1"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="notes"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Test Cases">
                            <field name="case_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="normal_range"/>
                                    <field name="units"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="lab_test_type_action" model="ir.actions.act_window">
        <field name="name">Lab Test Types</field>
        <field name="res_model">oeh.lab.test.type</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ============================================================
         LAB REQUESTS
         ============================================================ -->

    <record id="laboratory_tree" model="ir.ui.view">
        <field name="name">oeh.laboratory.list</field>
        <field name="model">oeh.laboratory</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="test_type_id"/>
                <field name="request_date"/>
                <field name="test_date"/>
                <field name="state"/>
                <field name="invoice_id"/>
            </list>
        </field>
    </record>
