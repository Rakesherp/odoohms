    <record id="lab_result_form" model="ir.ui.view">
        <field name="name">oeh.lab.test.result.form</field>
        <field name="model">oeh.lab.test.result</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_tested"
                            string="Tested"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>

                    <button name="action_create_lab_invoice"
                            string="Create Lab Invoice"
                            type="object"
                            invisible="state != 'done' or invoice_id"/>

                    <button name="%(action_report_lab_result)d"
                            string="Print Report"
                            type="action"
                            invisible="state != 'done'"/>

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state == 'cancel'"/>

                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancel'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,done,cancel"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">

                        <button name="action_create_lab_invoice"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                invisible="not invoice_id">
                            <field name="invoice_id"
                                   widget="statinfo"
                                   string="Invoice"/>
                        </button>

                    </div>

                    <h1>
                        <field name="name" readonly="1"/>
                    </h1>

                    <group string="Main Info">
                        <group>
                            <field name="date_analysis"/>
                            <field name="pathologist_id"/>
                            <field name="doctor_id"/>
                        </group>
                        <group>
                            <field name="test_type_id"/>
                            <field name="patient_id"/>
                            <field name="date_requested" readonly="1"/>
                            <field name="request_id" readonly="1"/>
                        </group>
                    </group>

                    <group string="Test Cases">
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name" readonly="1"/>
                                <field name="result_text"/>
                                <field name="normal_range" readonly="1"/>
                                <field name="units" readonly="1"/>
                                <field name="notes"/>
                            </list>
                        </field>
                    </group>

                    <group string="Extra Info">
                        <field name="result"/>
                        <field name="diagnosis"
                               placeholder="Clinical interpretation / diagnosis..."/>
                        <field name="remarks"
                               placeholder="Additional laboratory remarks..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="lab_result_action" model="ir.actions.act_window">
        <field name="name">Lab Tests Results</field>
        <field name="res_model">oeh.lab.test.result</field>
        <field name="view_mode">list,form</field>
       <!--  <field name="search_view_id" ref="lab_result_search"/> -->
    </record>

</odoo>
