    <record id="laboratory_form" model="ir.ui.view">
        <field name="name">oeh.laboratory.form</field>
        <field name="model">oeh.laboratory</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_lab_test"
                            string="Create Lab Test"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft' or result_id"/>

                    <button name="action_open_lab_test"
                            string="Open Lab Test"
                            type="object"
                            invisible="not result_id"/>

                    <button name="action_create_lab_invoice"
                            string="Create Lab Invoice"
                            type="object"
                            invisible="invoice_id"/>

                    <button name="action_cancel"
                            string="Cancel Lab Request"
                            type="object"
                            invisible="state == 'cancel'"/>

                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancel'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,tested,cancel"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">

                        <button name="action_open_lab_test"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-flask"
                                invisible="not result_id">
                            <field name="result_id"
                                   widget="statinfo"
                                   string="Lab Test"/>
                        </button>

                        <button name="action_create_lab_invoice"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                invisible="not invoice_id">
                            <field name="invoice_id"
                                   widget="statinfo"
                                   string="Invoice"/>
                        </button>

                    </div>

                    <h1>
                        <field name="name" readonly="1"/>
                    </h1>

                    <group string="Main Info">
                        <group>
                            <field name="test_type_id"/>
                            <field name="request_date"/>
                            <field name="test_date"/>
                            <field name="invoice_to_insurance"/>
                        </group>
                        <group>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="invoice_id" readonly="1"/>
                        </group>
                    </group>

                    <group string="Notes">
                        <field name="notes"
                               nolabel="1"
                               placeholder="Clinical notes / instructions..."/>
                    </group>

                    <group string="Result">
                        <field name="result_id" readonly="1"/>
                        <field name="result" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="laboratory_action" model="ir.actions.act_window">
        <field name="name">Lab Requests</field>
        <field name="res_model">oeh.laboratory</field>
        <field name="view_mode">list,form</field>
        <!-- <field name="search_view_id" ref="laboratory_search"/> -->
    </record>

    <record id="laboratory_action_draft" model="ir.actions.act_window">
        <field name="name">Draft Lab Requests</field>
        <field name="res_model">oeh.laboratory</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','draft')]</field>
       <!--  <field name="search_view_id" ref="laboratory_search"/> -->
    </record>

    <record id="laboratory_action_today_draft" model="ir.actions.act_window">
        <field name="name">Today's Draft Lab Requests</field>
        <field name="res_model">oeh.laboratory</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','draft'), ('request_date','&gt;=', context_today()), ('request_date','&lt;', context_today() + relativedelta(days=1))]</field>
        <!-- <field name="search_view_id" ref="laboratory_search"/> -->
    </record>


    <!-- ============================================================
         LAB TEST RESULTS
         ============================================================ -->

    <record id="lab_result_list" model="ir.ui.view">
        <field name="name">oeh.lab.test.result.list</field>
        <field name="model">oeh.lab.test.result</field>
        <field name="arch" type="xml">
            <list decoration-danger="result == 'critical'"
                  decoration-warning="result == 'abnormal'">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="test_type_id"/>
                <field name="doctor_id"/>
                <field name="date_analysis"/>
                <field name="result"/>
                <field name="state"/>
                <field name="invoice_id"/>
            </list>
        </field>
    </record>

