<odoo>

    <record id="appointment_tree" model="ir.ui.view">
        <field name="name">appointment.tree</field>
        <field name="model">oeh.appointment</field>

        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'"
                  decoration-success="state == 'done'"
                  decoration-info="state == 'progress'">
                <field name="appointment_no"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_date"/>
                <field name="session"/>
                <field name="queue_no" string="Token"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Doctor-wise / Receptionist-wise day planner. Color-coded by
         doctor so the front desk can see every doctor's day at a glance;
         a doctor logged in with "My Appointments" only sees their own
         color anyway. -->
    <record id="appointment_calendar" model="ir.ui.view">
        <field name="name">appointment.calendar</field>
        <field name="model">oeh.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Appointments" date_start="appointment_date"
                      date_stop="appointment_date_end"
                      color="doctor_id" mode="week" event_open_popup="true"
                      quick_create="0">
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="session"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Kanban view for the doctor-facing "My Appointments" worklist -->
    <record id="appointment_kanban" model="ir.ui.view">
        <field name="name">appointment.kanban</field>
        <field name="model">oeh.appointment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_date"/>
                <field name="session"/>
                <field name="queue_no"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <strong class="o_kanban_record_title">
                                        <field name="patient_id"/>
                                    </strong>
                                </div>
                                <div>
                                    <field name="doctor_id"/>
                                </div>
                                <div>
                                    <field name="appointment_date"/>
                                    <span> · </span>
                                    <field name="session"/>
                                </div>
                                <div t-if="record.queue_no.raw_value">
                                    Token: <field name="queue_no"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="state" widget="label_selection"
                                               options="{'classes': {'draft': 'default', 'confirm': 'info', 'progress': 'warning', 'done': 'success', 'cancel': 'danger'}}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="appointment_search" model="ir.ui.view">
    <field name="name">appointment.search</field>
    <field name="model">oeh.appointment</field>

    <field name="arch" type="xml">
        <search string="My Search View">

    <field name="appointment_no"/>
    <field name="patient_id"/>
    <field name="doctor_id"/>
    <field name="session"/>

    <separator/>

    <filter string="Appointment Date"
            name="appointment_date_filter"
            date="appointment_day"/>

    <filter string="My Appointments"
            name="filter_mine"
            domain="[('doctor_id.user_id', '=', uid)]"/>

    <separator/>

    <filter string="Morning"
            name="filter_morning"
            domain="[('session', '=', 'morning')]"/>

    <filter string="Afternoon"
            name="filter_afternoon"
            domain="[('session', '=', 'afternoon')]"/>

    <filter string="Evening"
            name="filter_evening"
            domain="[('session', '=', 'evening')]"/>

    <separator/>

    <filter string="Draft"
            name="filter_draft"
            domain="[('state', '=', 'draft')]"/>

    <filter string="Confirmed"
            name="filter_confirm"
            domain="[('state', '=', 'confirm')]"/>

    <filter string="Cancelled"
            name="filter_cancel"
            domain="[('state', '=', 'cancel')]"/>

    <group>
        <filter string="Doctor"
                name="group_doctor"
                context="{'group_by': 'doctor_id'}"/>

        <filter string="Session"
                name="group_session"
                context="{'group_by': 'session'}"/>

        <filter string="Date"
                name="group_date"
                context="{'group_by': 'appointment_day'}"/>

        <filter string="Status"
                name="group_state"
                context="{'group_by': 'state'}"/>
    </group>

</search>
    </field>
</record>
<record id="appointment_form" model="ir.ui.view">
    <field name="name">appointment.form</field>
    <field name="model">oeh.appointment</field>

    <field name="arch" type="xml">
        <form>

            <header>

                <button name="action_confirm"
                        string="Check-in / Confirm"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"/>

                <button name="action_done"
                        string="Done"
                        type="object"
                        invisible="state != 'progress'"/>

                <button name="action_cancel"
                        string="Cancel"
                        type="object"
                        invisible="state in ('done', 'cancel')"/>

                <button name="action_open_consultation"
                        string="Consultation Workspace"
                        type="object"
                        class="btn-primary"
                        invisible="state not in ('confirm', 'progress')"/>

                <field name="state"
                       widget="statusbar"/>

            </header>

            <sheet>

                <div class="alert alert-info"
                     role="alert"
                     style="font-size:100%; margin:0 10px;">
                    <h1 class="text-center">
                        <b>APPOINTMENT</b>
                    </h1>
                </div>

                <br/>

                <div class="oe_button_box" name="button_box">

                    <button name="action_open_meeting"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calendar"
                            invisible="not meeting_id">
                        <span>Meeting</span>
                    </button>

                    <button name="action_view_prescriptions"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o">
                        <field name="prescription_count"
                               widget="statinfo"
                               string="Prescriptions"/>
                    </button>

                    <button name="action_view_invoice"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-money"
                            invisible="not invoice_id">
                        <span>Invoice</span>
                    </button>

                </div>

                <widget name="web_ribbon"
                        title="Token Issued"
                        invisible="not queue_no"/>

                <group>
                    <group>
                        <field name="appointment_no"/>
                        <field name="patient_id"/>
                        <field name="doctor_id"/>
                        <field name="invoice_partner_id"/>
                    </group>

                    <group>
                        <field name="appointment_date" string="Appointment Date &amp; Time"/>
                        <field name="session" readonly="1"/>
                        <field name="queue_no" readonly="1"/>
                        <field name="followup_date"/>
                    </group>
                </group>

                <group>
                    <field name="chief_complaint"/>
                </group>

            </sheet>

            <!-- Chatter MUST be outside sheet -->
            <chatter/>

        </form>
    </field>
</record>

    <record id="appointment_action"
        model="ir.actions.act_window">

        <field name="name">Appointments</field>

        <field name="res_model">oeh.appointment</field>

        <field name="view_mode">calendar,list,form</field>

        <field name="search_view_id" ref="appointment_search"/>

        <field name="context">{'search_default_filter_today': 1, 'create': False}</field>

        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">Book the first appointment</p>
            <p>Use Book Appointment for the guided front-desk workflow. The booking reserves a token in Scheduled status; Check-in changes it to Waiting.</p>
        </field>

    </record>

    <!-- Doctor-facing worklist: same model/action, defaulted to "just me,
         today onward", opened from the doctor's own menu. -->
    <record id="appointment_action_my" model="ir.actions.act_window">
        <field name="name">My Appointments</field>
        <field name="res_model">oeh.appointment</field>
        <field name="view_mode">kanban,list,calendar,form</field>
        <field name="search_view_id" ref="appointment_search"/>
        <field name="context">
    {'search_default_filter_mine': 1, 'search_default_filter_next_7': 1}
</field>
    </record>

</odoo>