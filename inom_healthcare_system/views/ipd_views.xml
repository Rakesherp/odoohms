<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ipd_tree" model="ir.ui.view">
        <field name="name">ipd.tree</field>
        <field name="model">oeh.ipd</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'under_treatment'"
                  decoration-info="status == 'admitted'"
                  decoration-warning="status == 'discharge_pending'"
                  decoration-muted="status in ('closed','discharged')">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="admission_type" widget="badge"/>
                <field name="ward_id"/>
                <field name="bed_id"/>
                <field name="attending_doctor_id"/>
                <field name="nurse_in_charge_id"/>
                <field name="admission_date"/>
                <field name="stay_days"/>
                <field name="insurance_required"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="ipd_kanban" model="ir.ui.view">
        <field name="name">ipd.kanban</field>
        <field name="model">oeh.ipd</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_oeh_ipd_kanban">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="ward_id"/>
                <field name="bed_id"/>
                <field name="attending_doctor_id"/>
                <field name="nurse_in_charge_id"/>
                <field name="admission_date"/>
                <field name="stay_days"/>
                <field name="insurance_required"/>
                <field name="status"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <strong><field name="name"/></strong>
                                <span t-if="record.insurance_required.raw_value" class="badge text-bg-warning">Insurance</span>
                            </div>
                            <div class="fw-bold fs-5"><field name="patient_id"/></div>
                            <div class="text-muted mt-1">
                                <i class="fa fa-bed me-1" title="Bed" aria-label="Bed"/>
                                <field name="bed_id"/>
                            </div>
                            <div class="text-muted">
                                <i class="fa fa-hospital-o me-1" title="Ward" aria-label="Ward"/>
                                <field name="ward_id"/>
                            </div>
                            <div class="text-muted">
                                <i class="fa fa-user-md me-1" title="Attending doctor" aria-label="Attending doctor"/>
                                <field name="attending_doctor_id"/>
                            </div>
                            <div class="text-muted" t-if="record.nurse_in_charge_id.raw_value">
                                <i class="fa fa-user-nurse me-1" title="Nurse in charge" aria-label="Nurse in charge"/>
                                <field name="nurse_in_charge_id"/>
                            </div>
                            <div class="d-flex justify-content-between mt-3">
                                <span><field name="admission_date"/></span>
                                <span><field name="stay_days"/> days</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="ipd_search" model="ir.ui.view">
        <field name="name">ipd.search</field>
        <field name="model">oeh.ipd</field>
        <field name="arch" type="xml">
            <search string="IPD Admissions">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="ward_id"/>
                <field name="bed_id"/>
                <field name="attending_doctor_id"/>
                <filter name="active_admissions"
                        string="Active Admissions"
                        domain="[('status','in',('admitted','under_treatment','discharge_pending'))]"/>
                <filter name="insurance_required"
                        string="Insurance Required"
                        domain="[('insurance_required','=',True)]"/>
            </search>
        </field>
    </record>


    <record id="ipd_form" model="ir.ui.view">
        <field name="name">ipd.form</field>
        <field name="model">oeh.ipd</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm_admission" type="object" string="Confirm Admission" class="btn-primary" invisible="status != 'draft'"/>
                    <button name="action_admit" type="object" string="Admit Patient" class="btn-primary" invisible="status != 'confirmed'"/>
                    <button name="action_start_treatment" type="object" string="Start Treatment" invisible="status != 'admitted'"/>
                    <button name="action_initiate_discharge" type="object" string="Initiate Discharge" invisible="status not in ('admitted','under_treatment')"/>
                    <button name="action_discharge" type="object" string="Discharge Patient" class="btn-primary" invisible="status != 'discharge_pending'"/>
                    <button name="%(action_report_ipd_discharge_summary)d" type="action" string="Print Discharge Summary" icon="fa-print" invisible="status not in ('discharged','closed')"/>
                    <button name="action_close" type="object" string="Close" invisible="status != 'discharged'"/>
                    <button name="action_cancel_admission" type="object" string="Cancel" invisible="status not in ('draft','confirmed')"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,confirmed,admitted,under_treatment,discharge_pending,discharged,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bed" type="object" class="oe_stat_button" icon="fa-bed" invisible="not bed_id">
                            <span class="o_stat_text">Bed</span>
                        </button>
                        <button name="action_view_insurance" type="object" class="oe_stat_button" icon="fa-shield" invisible="not insurance_required">
                            <span class="o_stat_text">Insurance</span>
                        </button>
                        <button name="action_view_preauthorization" type="object" class="oe_stat_button" icon="fa-check-square-o" invisible="not pre_authorization_id and not insurance_required">
                            <span class="o_stat_text">Pre-Auth</span>
                        </button>
                        <button name="action_create_insurance_claim" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not insurance_required or insurance_claim_id">
                            <span class="o_stat_text">Create Claim</span>
                        </button>
                        <button name="action_view_billing" type="object" class="oe_stat_button" icon="fa-money" invisible="not billing_id">
                            <span class="o_stat_text">Billing</span>
                        </button>
                        <button name="action_create_invoice" type="object" class="oe_stat_button" icon="fa-file-invoice-dollar" invisible="not billing_id">
                            <field name="invoice_count" widget="statinfo" string="Invoice"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Admission Reference"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group string="Patient &amp; Admission">
                        <group>
                            <field name="patient_id" readonly="status not in ('draft','confirmed')"/>
                            <field name="admission_type" readonly="status not in ('draft','confirmed')"/>
                            <field name="reason" placeholder="Reason for admission..."/>
                            <field name="allergy_alert" readonly="1"/>
                        </group>
                        <group>
                            <field name="admission_date" readonly="1"/>
                            <field name="discharge_date" readonly="1"/>
                            <field name="stay_days" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Bed Allocation &amp; Care Team">
                        <group>
                            <field name="ward_id" readonly="1"/>
                            <field name="bed_id" readonly="status not in ('draft','confirmed')"/>
                            <field name="attending_doctor_id" readonly="status in ('discharged','closed')"/>
                        </group>
                        <group>
                            <field name="nurse_in_charge_id" readonly="status in ('discharged','closed')"/>
                            <field name="nurse_in_charge" invisible="1"/>
                            <field name="is_active_admission" invisible="1"/>
                        </group>
                    </group>
                    <group string="Insurance" class="mt-3">
                        <group>
                            <field name="insurance_required" readonly="status not in ('draft','confirmed')"/>
                            <field name="insurance_partner_id" invisible="not insurance_required" readonly="status not in ('draft','confirmed')"/>
                            <field name="policy_number" invisible="not insurance_required" readonly="status not in ('draft','confirmed')"/>
                        </group>
                        <group>
                            <field name="pre_authorization_id" invisible="not insurance_required" readonly="status not in ('draft','confirmed')"/>
                            <field name="insurance_claim_id" invisible="not insurance_required" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Clinical">
                            <field name="diagnosis" placeholder="Diagnosis / clinical notes..."/>
                        </page>
                        <page string="Discharge">
                            <group>
                                <field name="discharge_reason" placeholder="Reason for discharge..."/>
                                <field name="discharge_summary" widget="html" placeholder="Final discharge summary..."/>
                            </group>
                            <div class="alert alert-info mt-3" role="alert">
                                Complete the discharge summary before using <strong>Discharge Patient</strong>.
                                The summary can then be printed from the form.
                            </div>
                        </page>
                        <page string="Finance &amp; Insurance">
                            <group>
                                <field name="billing_id" readonly="1"/>
                                <field name="invoice_id" readonly="1"/>
                                <field name="insurance_claim_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_ipd" model="ir.actions.act_window">
        <field name="name">IPD Admissions</field>
        <field name="res_model">oeh.ipd</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="ipd_search"/>
        <field name="context">{'search_default_active_admissions': 1}</field>
    </record>
</odoo>
