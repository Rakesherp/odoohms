<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================
         Product Medicine Form
         ========================================================= -->
    <record id="product_product_medicine_form_view" model="ir.ui.view">
        <field name="name">product.product.medicine.form</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <form>
                <header/>

                <sheet>

                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">

                        <button name="action_view_stock_moves"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-exchange">
                            <span class="o_stat_info">
                                <span class="o_stat_text">Stock Moves</span>
                            </span>
                        </button>

                        <button name="action_view_batches"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-cubes">
                            <field name="batch_count"
                                   widget="statinfo"
                                   string="Batches"/>
                        </button>

                        <button name="action_view_prescription_lines"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o">
                            <field name="prescription_line_count"
                                   widget="statinfo"
                                   string="Prescriptions"/>
                        </button>

                    </div>

                    <!-- Product Title -->
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="Medicine Name"/>
                        </h1>
                    </div>

                    <!-- Medicine Information -->
                    <group>

                        <group string="Medicine Information">
                            <field name="is_medicine"/>
                            <field name="generic_name"/>
                            <field name="brand_name"/>
                            <field name="strength"/>
                            <field name="medicine_type"/>
                            <field name="drug_category"/>
                            <field name="is_generic"/>
                            <field name="is_controlled"/>
                        </group>

                        <group string="Product Information">
                            <field name="default_code"/>
                            <field name="barcode"/>
                            <field name="categ_id"/>
                            <field name="uom_id"/>
                            <field name="list_price"/>
                            <field name="standard_price"/>
                            <field name="is_storable"/>
                        </group>

                    </group>

                    <!-- Stock Information -->
                    <group string="Stock">

                        <group>
                            <field name="min_stock"/>
                            <field name="qty_available"
                                   readonly="1"/>
                            <field name="is_low_stock"
                                   readonly="1"/>
                        </group>

                        <group>
                            <field name="nearest_expiry"
                                   readonly="1"/>
                            <field name="batch_count"
                                   readonly="1"/>
                        </group>

                    </group>

                    <notebook>

                        <page string="Clinical">

                            <group>
                                <field name="dosage_info"/>
                                <field name="storage_instructions"/>
                                <field name="manufacturer_id"/>
                            </group>

                        </page>

                        <page string="Medicine Batches">

                            <field name="medicine_batch_ids"
                                   context="{'default_product_id': id}">

                                <list>
                                    <!-- <field name="name"/> -->
                                   <!--  <field name="batch_number"/>
                                    <field name="expiry_date"/>
                                    <field name="status"/> -->
                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>
        </field>
    </record>


    <!-- =========================================================
         Medicine Product List
         ========================================================= -->
    <record id="product_product_medicine_list_view" model="ir.ui.view">
        <field name="name">product.product.medicine.list</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list string="Medicines"
                  decoration-danger="is_low_stock"
                  decoration-warning="is_controlled">

                <field name="name"/>
                <field name="default_code" string="Code"/>
                <field name="generic_name"/>
                <field name="brand_name"/>
                <field name="strength"/>
                <field name="medicine_type"/>
                <field name="drug_category"/>
                <field name="manufacturer_id"/>
                <field name="qty_available" string="On Hand"/>
                <field name="min_stock" optional="hide"/>
                <field name="nearest_expiry"/>
                <field name="is_controlled"/>
                <field name="is_low_stock"/>

            </list>
        </field>
    </record>


