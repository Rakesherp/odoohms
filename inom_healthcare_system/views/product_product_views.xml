    <!-- =========================================================
         Medicine Action
         ========================================================= -->
    <record id="action_medicine_products" model="ir.actions.act_window">
        <field name="name">Medicines</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_medicine', '=', True)]</field>
        <field name="context">{'default_is_medicine': True}</field>
    </record>


    <!-- =========================================================
         Action Views
         ========================================================= -->
    <record id="action_medicine_products_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="product_product_medicine_list_view"/>
        <field name="act_window_id" ref="action_medicine_products"/>
    </record>

    <record id="action_medicine_products_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="product_product_medicine_form_view"/>
        <field name="act_window_id" ref="action_medicine_products"/>
    </record>

</odoo>
